# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth (custom JWT) — use a long random secret (32+ chars)
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Dev bypass (skips sign-in; seeds Admin user + family)
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
DEV_BYPASS_USER_ID=dev-parent
DEV_BYPASS_FAMILY_ID=dev-family

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
