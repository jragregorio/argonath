<Project>
  <PropertyGroup>
    <!-- Agent MSI / assembly version ONLY. Independent of apps/web and packages/* (ADR-0004).
         Must increase monotonically forever. SemVer 2.0.0 — no single-digit patch cap. -->
    <Version>0.6.24</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Company>Warden</Company>
    <Product>Warden</Product>
    <Authors>Warden</Authors>
  </PropertyGroup>
</Project>
