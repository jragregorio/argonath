<Project>
  <PropertyGroup>
    <!-- Agent MSI / assembly version ONLY. Independent of apps/web and packages/* (ADR-0004).
         Must increase monotonically forever — never reset or jump. -->
    <Version>0.5.18</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Company>Warden</Company>
    <Product>Warden</Product>
    <Authors>Warden</Authors>
  </PropertyGroup>
</Project>
