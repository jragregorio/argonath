generator client {
  provider = "prisma-client-js"
  // Loads relations via LATERAL JOIN in one statement. Supavisor transaction mode
  // requires pgbouncer=true, which wraps each call in BEGIN/DEALLOCATE/COMMIT, so
  // a per-relation SELECT costs a full round trip.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FamilyRole {
  Admin
  Parent
  Child
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   FamilyMember[]
  refreshTokens RefreshToken[]
}

model Family {
  id        String   @id @default(cuid())
  name      String
  parentPin String?
  /// IANA time zone for allowed hours and "today" usage (e.g. Asia/Manila).
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children      Child[]
  auditLogs     AuditLog[]
  members       FamilyMember[]
  refreshTokens RefreshToken[]
  nudges        Nudge[]
}

model FamilyMember {
  id        String     @id @default(cuid())
  userId    String
  familyId  String
  role      FamilyRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  familyId      String
  tokenFamilyId String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  replacedById  String?
  userAgent     String?
  ip            String?
  createdAt     DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([tokenFamilyId])
  @@index([userId])
  @@index([expiresAt])
}

model Child {
  id          String   @id @default(cuid())
  familyId    String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family             Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  devices            Device[]
  policies           ScreenTimePolicy[]
  extensionRequests  ExtensionRequest[]
  snapshots          Snapshot[]
  extensionOverrides ExtensionOverride[]
  nudges             Nudge[]

  @@index([familyId])
  @@index([familyId, createdAt])
}

model Device {
  id           String    @id @default(cuid())
  childId      String
  pairingCode  String?   @unique
  pairingExpiresAt DateTime?
  deviceToken  String?   @unique
  platform     String    @default("windows")
  machineName  String?
  displayName  String?
  agentVersion String?
  lastSeenAt   DateTime?
  isOnline     Boolean   @default(false)
  isLocked     Boolean   @default(false)
  adminLock    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  child             Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  usageLogs         UsageLog[]
  extensionRequests ExtensionRequest[]
  snapshots         Snapshot[]
  nudges            Nudge[]

  @@index([childId])
  @@index([deviceToken])
  @@index([lastSeenAt])
}

model ScreenTimePolicy {
  id                String   @id @default(cuid())
  childId           String
  dailyLimitMinutes Int      @default(120)
  allowedWindows    Json     @default("[]")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model UsageLog {
  id            String   @id @default(cuid())
  deviceId      String
  date          DateTime @db.Date
  activeMinutes Int      @default(0)
  idleMinutes   Int      @default(0)
  updatedAt     DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, date])
  @@index([deviceId])
}

model ExtensionRequest {
  id               String    @id @default(cuid())
  childId          String
  deviceId         String
  requestedMinutes Int
  status           String    @default("pending")
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime  @default(now())

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([deviceId])
  @@index([status])
  @@index([status, createdAt])
  @@index([resolvedAt])
}

model ExtensionOverride {
  id              String   @id @default(cuid())
  childId         String
  extraMinutes    Int
  expiresAt       DateTime
  sourceRequestId String?
  createdAt       DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([expiresAt])
}

model Snapshot {
  id          String   @id @default(cuid())
  childId     String
  deviceId    String
  type        String
  storageKey  String
  /// pending | ready | failed
  status      String   @default("ready")
  requestedBy String
  capturedAt  DateTime @default(now())
  /// Set when a parent has opened the Snapshots page (clears nav badge).
  viewedAt    DateTime?
  expiresAt   DateTime?

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([deviceId])
  @@index([deviceId, status])
  @@index([status, viewedAt])
  @@index([childId, capturedAt])
  @@index([childId, status, viewedAt])
  @@index([expiresAt])
}

model Nudge {
  id         String    @id @default(cuid())
  familyId   String
  childId    String
  deviceId   String
  message    String    @default("Your parent wants your attention")
  /// pending | delivered | seen | expired
  status     String    @default("pending")
  /// ok | on_my_way
  response   String?
  requestedBy String
  createdAt  DateTime  @default(now())
  seenAt     DateTime?
  expiresAt  DateTime

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([familyId, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([createdAt])
  @@index([familyId, createdAt])
}

model CaptureRateLimit {
  id        String   @id @default(cuid())
  deviceId  String
  hourStart DateTime
  count     Int      @default(0)

  @@unique([deviceId, hourStart])
  @@index([deviceId])
}
