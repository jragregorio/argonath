{
  "name": "warden",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:validate": "npm run db:validate -w @warden/db",
    "db:up": "docker compose up -d",
    "test:core": "node scripts/verify-core-flow.mjs",
    "test:reset": "node scripts/reset-usage.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  }
}
